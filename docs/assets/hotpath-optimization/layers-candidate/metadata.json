  "definitions": {
    "normal": "Uninstrumented fresh expression: build, evaluate and synchronize wall times; total spans all three.",
    "diagnostic": "Same public call with temporary Python wrappers. Inclusive time contains child hooks; exclusive time subtracts instrumented child intervals. Wrapper/timer overhead is not corrected. Use this phase for attribution, normal for speed comparison.",
    "cpu_direct": "Preallocated input/output pointers passed to the generated host C function; includes ctypes bridge and generated computation, with no frontend build, lookup or allocation.",
    "cuda_direct": "Preallocated native buffers passed to CUDAProgram.submit, then Engine.synchronize. submit is native binding/validation/Graph submission wall time; complete also contains waiting and reaping, not pure GPU execution.",
    "collect": "_lazy._collect: live graph traversal and cached output projection lookup.",
    "dependencies": "_lazy._dependencies: live custom definition consistency and identity.",
    "key": "_lazy._structure_key: canonical topology/binding key construction.",
    "cache_get": "dict.get including key hashing/equality; this is separate from key construction.",
    "execute": "Engine._execute including inputs, backend call and Tensor wrapping.",
    "host_run": "HostExecutable.run including ABI input checks, output allocation and native C invocation.",
    "host_alloc": "HostStorage.__init__ during a measured call; in these workloads this allocates outputs.",
    "host_native": "Actual ctypes host C function invocation from HostExecutable.run.",
    "cuda_prepared": "_Prepared.run including Python port checks, reap, native run, ownership retention and result wrapping.",
    "cuda_ports": "_Prepared._check_ports public input contract/access preparation.",
    "cuda_reap": "ExecutionSession.reap; includes Python owner/event queue and native reap. Calls inside synchronize are included.",
    "cuda_native_run": "CUDAProgram.run through nanobind, including native output allocation and submit."
  },
